# 바이너리 형식 — CRLF 변환 금지
*.stl   binary
*.gcode binary
*.3mf   binary
*.bin   binary
*.elf   binary
*.hex   binary
*.bag   binary
*.db3   binary

# 슬라이서 ASCII STL도 binary로 취급 (안전)
# 텍스트 줄바꿈 정책
*.ino   text eol=lf
*.cpp   text eol=lf
*.c     text eol=lf
*.h     text eol=lf
*.py    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.md    text
